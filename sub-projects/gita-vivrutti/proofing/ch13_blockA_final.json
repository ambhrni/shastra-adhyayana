{
 "13.1.s1": "पूर्वषट्कद्वयोक्तार्थसङ्ग्रहपरोऽयमध्यायः ।",
 "13.1.s2": "तथाहि ।",
 "13.1.s3": "यत्प्रथमषट्के 'त्रैगुण्यविषया वेदाः'{^३} इत्यादिना प्राचुर्येण ज्ञानसाधनमाषष्ठसमाप्तेरुक्तम्, यच्च तत्र द्वितीयेऽध्याये 'न त्वेवाहम्'{^४} इत्यादिनाऽनादिनित्यत्वादिना जीवस्वरूपमुक्तम्, यच्च द्वितीयषट्के भगवत्स्वरूपमुक्तम्, यदपि सप्तमे 'भूमिरापः'{^५} इत्यादिना क्षेत्रशब्दितं भगवदावासस्थानमुक्तम्, तद्विकीर्णतयोक्तं सर्वं बुद्ध्यारोहार्थं सङ्क्षिप्यास्मिन्नध्याये प्रश्नपूर्वकं प्रदर्श्यते - **प्रकृतिमित्यादिना** ।",
 "13.1.s4": "**पुरुषं** जीवम् ।",
 "13.1.s5": "**ज्ञानं** ज्ञानसाधनम् ॥१॥",
 "13.2.s1": "ननु भगवत्स्वरूपज्ञानस्यैव पूर्वोक्तदिशा मुक्तिहेतुत्वात् तत्स्वरूपोक्तिर्युक्ता ।",
 "13.2.s2": "क्षेत्रस्वरूपं 'महाभूतानि'{^२} इत्यादिना किमर्थमत्रोच्यत इति चेन्न ।",
 "13.2.s3": "क्षेत्रज्ञत्वविशिष्टभगवज्ज्ञानोपयोगित्वात्, क्षेत्रोक्तिरिति क्षेत्रोद्देशपूर्वं भगवतः क्षेत्रज्ञत्वमाह - **इदमिति** ।",
 "13.2.s4": "**कौन्तेय** ।",
 "13.2.s5": "**इदं शरीरम्** अव्यक्तमहदहङ्कारादिकम् ।",
 "13.2.s6": "भगवदावासस्थानत्वात् क्षीयते स्थीयतेऽत्र भगवतेति व्युत्पत्त्या **क्षेत्रमित्यभिधीयते** ।",
 "13.2.s7": "**एतत्** अव्यक्तादिकं क्षेत्रशब्दितम् ।",
 "13.2.s8": "**यो वेत्ति** जानाति ।",
 "13.2.s9": "**तम्** ।",
 "13.2.s10": "**तद्विदः** क्षेत्रविदः ।",
 "13.2.s11": "**क्षेत्रज्ञमिति प्राहु**रित्यर्थः ।",
 "13.2.s12": "शरीरशब्दस्याव्यक्तादिपरत्वं च स्वपरिणामदेहादिवियोगद्वारा जीवस्य हिंसादिहेतुत्वात् ।",
 "13.2.s13": "'शर् शृ हिंसायाम्' इति धातोः भगवता प्रेर्यत्वादीरं च ।",
 "13.2.s14": "'ईर् प्रेरणे' इति धातोः ।",
 "13.2.s15": "शर् च तदीरं चेति शरीरमिति व्युत्पत्तेरिति ज्ञेयम् ।",
 "13.2.s16": "तेन 'सङ्घातश्चेतना' इति सङ्घातपदेन क्षेत्रविकारेष्वेकदेशत्वेनोक्तशरीरस्य कथं समस्तक्षेत्रत्वमुच्यत इति शङ्का निरस्ता ॥२॥",
 "13.3.s1": "जीवस्यापि किञ्चित् क्षेत्रज्ञानात् स किं क्षेत्रज्ञः, इत्यत आह - **क्षेत्रज्ञं चेति** ।",
 "13.3.s2": "**सर्वक्षेत्रेषु** अव्यक्तादिषु ।",
 "13.3.s3": "**क्षेत्रज्ञं** तु **मां विद्धि** ।",
 "13.3.s4": "न जीवम् ।",
 "13.3.s5": "क्षेत्रक्षेत्रज्ञयोर्यज्ज्ञानं **तज्ज्ञानम्** ।",
 "13.3.s6": "**मम** सम्यग्ज्ञानं **मतमि**त्यर्थः ।",
 "13.3.s7": "अत्र 'सर्वक्षेत्रेषु' इत्युक्तिरिदं शरीरमित्यत्र शरीरपदोक्ताव्यक्तादेः क्षीयतेऽत्रेश्वरेणेति व्युत्पत्त्या क्षेत्रपदवाच्यत्वमिति सूचनाय ॥३॥",
 "13.4.s1": "क्षेत्रादिस्वरूपं वक्तुं प्रतिजानीते - **तत्क्षेत्रमिति** ।",
 "13.4.s2": "**तत्क्षेत्रं** यद्भगवन्निवासस्थानतया क्षेत्रपदोक्तम् ।",
 "13.4.s3": "देहद्वारा जीवहिंसाहेतुतया ईश्वरप्रेर्यत्वहेतुना च शरीरपदेन प्रकृतम् अव्यक्तादि **यच्च** यत्स्वरूपं **यादृक्** यत्प्रकारं **यद्विकारि** ।",
 "13.4.s4": "कर्मधारयात् मतुप् ।",
 "13.4.s5": "येन विकारेण युक्तम् ।",
 "13.4.s6": "**यतः** यादृशप्रवृत्त्यनुकूलधर्मयुक्तात् पुरुषात् ।",
 "13.4.s7": "**यत्** इणः शत्रन्तं रूपम् ।",
 "13.4.s8": "गतिमत् ।",
 "13.4.s9": "प्रवर्तत इति यावत् ।",
 "13.4.s10": "**स च** प्रवर्तकः ।",
 "13.4.s11": "**यः** यत्स्वरूपः ।",
 "13.4.s12": "**यत्प्रभावः** यादृशप्रवृत्त्यनुकूलधर्मेतरसामर्थ्यवान् ।",
 "13.4.s13": "**तत्** सर्वम् ।",
 "13.4.s14": "**समासेन** सङ्क्षेपेण ।",
 "13.4.s15": "**मे** सकाशात् ।",
 "13.4.s16": "**श्रुणु** श्रुत्वा निष्ठां कुरु ॥४॥",
 "13.5.s1": "श्रोतृविश्वासजननायोच्यमानं प्रामाणिकमित्याह - **ऋषिभिरिति** ।",
 "13.5.s2": "तदित्यनुषज्यते ।",
 "13.5.s3": "यत् 'श्रुणु' इत्युक्तं क्षेत्रादिस्वरूपं तत् ।",
 "13.5.s4": "**ऋषिभिर्बहुधा गीतम्** ।",
 "13.5.s5": "गै शब्दे ।",
 "13.5.s6": "उक्तमित्यर्थः ।",
 "13.5.s7": "**विविधैः छन्दोभि**र्वेदैः ।",
 "13.5.s8": "प्रत्येकं **गीतमिति** सर्वत्रानुषज्यते ।",
 "13.5.s9": "**हेतुमद्भिः** न्यायोपेतैः ।",
 "13.5.s10": "**ब्रह्मसूत्रपदैश्च** ।",
 "13.5.s11": "**विनिश्चितमे**व **श्रुणु** इत्यन्वयः ॥५॥",
 "13.6.s1": "क्षेत्रं यच्च यादृक् च तच्छ्रुण्विति प्रतिज्ञातमाह - **महाभूतानीति** ।",
 "13.6.s2": "**पञ्चमहाभूतानि** ।",
 "13.6.s3": "महत्तत्त्वमप्यहङ्कारशब्देन गृह्यते ।",
 "13.6.s4": "**बुद्धिरन्तःकरणविशेषः** ।",
 "13.6.s5": "**अव्यक्तं** त्रिगुणात्मकं प्रधानम् ।",
 "13.6.s6": "**'इन्द्रियाणि दशैकं च'** इति ज्ञानेन्द्रियमनोभेदेनैकादशेन्द्रियाणि ।",
 "13.6.s7": "**इन्द्रियगोचराः** श्रोत्रादिविषयाः शब्दाद्याः **पञ्च च** ।",
 "13.6.s8": "**एतत्क्षेत्रम्** ।",
 "13.6.s9": "**समासेन** सङ्क्षेपेण ।",
 "13.6.s10": "महाभूतत्वादिप्रकारोपेतमुदाहृतमित्यन्वयः ॥६॥",
 "13.7.s1": "'क्षेत्रं यद्विकारि' इति प्रतिज्ञातक्षेत्रविकारमाह - **इच्छेति** ।",
 "13.7.s2": "**सङ्घातो** देहः ।",
 "13.7.s3": "**चेतना** चेतसो व्याप्तिः ।",
 "13.7.s4": "**धृति**र्धैर्यम् ।",
 "13.7.s5": "**एतत्** प्रागुक्तम् ।",
 "13.7.s6": "**क्षेत्रम्** इच्छादिविकारोपेतं सङ्क्षेपेणोक्तमित्यर्थः ।",
 "13.7.s7": "महाभूतादिक्षेत्राभिमानिनः ।",
 "13.7.s8": "तद्विकारेच्छाद्यभिमानिनश्चावश्यं ज्ञेयत्वादुच्यन्ते ।",
 "13.7.s9": "आकाशाभिमानी **विघ्नेशः** ।",
 "13.7.s10": "वायुमानी मुख्यवायुजो **मरीचि**नामा ।",
 "13.7.s11": "अग्निमानी **वह्निः** ।",
 "13.7.s12": "अबभिमानी **वरुणः** ।",
 "13.7.s13": "भूमिमानिनी **धरादेवी** ।",
 "13.7.s14": "अहङ्कारः **शिवः** ।",
 "13.7.s15": "महान् **ब्रह्मा** ।",
 "13.7.s16": "बुद्धिः **उमा** ।",
 "13.7.s17": "अव्यक्तम् **श्रीदेवी** ।",
 "13.7.s18": "इन्द्रियेषु मनोऽभिमानिनः **स्कन्देन्द्रानिरुद्धाः** ।",
 "13.7.s19": "श्रोत्रं **चन्द्रः** ।",
 "13.7.s20": "त्वक् वायुसुतो **मरुत्** ।",
 "13.7.s21": "चक्षुः **सूर्यः** ।",
 "13.7.s22": "जिह्वा **वरुणस्य** रूपान्तरम् ।",
 "13.7.s23": "घ्राणम् **अश्विनौ** ।",
 "13.7.s24": "वाक् **अग्निः** ।",
 "13.7.s25": "हस्तौ वायुसुतौ **मरुतौ** ।",
 "13.7.s26": "पादौ तु विष्णुनाऽऽविष्टौ शचीसुतौ **यज्ञशम्भु**नामकौ ।",
 "13.7.s27": "पायु**र्यमः** ।",
 "13.7.s28": "उपस्थः **शिवः, मनु**श्च ।",
 "13.7.s29": "इन्द्रियगोचरेषु शब्दस्पर्शरूपरसगन्धाभिमानिनः **शिवपुत्राः** पञ्च ज्ञेयाः ।",
 "13.7.s30": "विकारेषु इच्छा **श्रीर्भारती** च ।",
 "13.7.s31": "द्वेषदुःखाभिमानिनौ **कलिद्वापरौ** ।",
 "13.7.s32": "सुखं **मुख्यवायुः** ।",
 "13.7.s33": "धृतिः **सरस्वती भारती** च ।",
 "13.7.s34": "चेतना **श्रीः** ।",
 "13.7.s35": "सङ्घातमानिनोऽन्ये चेतनाः ज्ञेयाः ।",
 "13.7.s36": "अभिमानिनां प्रागुक्तव्युत्पत्त्या भगवन्निवासत्वादेव क्षेत्रनामत्वम् ।",
 "13.7.s37": "क्षेत्रविकारित्वमपि महदादिभ्योऽतिशयेन विकारितया स्थितत्वादिति ज्ञेयम् ॥७॥",
 "13.8.s1": "एवं प्रतिज्ञातार्थषट्कमध्ये यच्च यादृक् च यद्विकारीति त्रयमुक्त्वा स च यो यत्प्रभावश्चेति प्रतिज्ञातार्थद्वयं 'ज्ञेयं यत्तत्' इत्यादिना वक्तुम्, न यादृश-तादृशेन श्रवणेन तदनुभवारूढं भवतीति भावेन वक्ष्यमाणज्ञेयद्वयभूतभगवज्ज्ञानस्य साधनान्याह - **अमानित्वमित्यादि पञ्चकेन** ।",
 "13.8.s2": "**अमानित्वम्** आत्मनः श्लाघनराहित्यम् ।",
 "13.8.s3": "आत्माल्पत्वं ज्ञात्वाऽपि महत्त्वप्रदर्शनं **दम्भः** ।",
 "13.8.s4": "तद्राहित्यम**दम्भित्वम्** ।",
 "13.8.s5": "**क्षान्तिः** सहिष्णुत्वम् ।",
 "13.8.s6": "**आर्जवं** सन्मार्गे मनोवाक्कायकर्मणामवैपरीत्यम् ।",
 "13.8.s7": "**आचार्योपासनं** ज्ञानिनां सेवा ।",
 "13.8.s8": "**शौचं** बाह्यान्तरशुद्धिः ।",
 "13.8.s9": "'शौचं तु द्विविधं प्रोक्तं बाह्यमाभ्यन्तरं तथा । मृज्जलाभ्यां स्मृतं बाह्यं भावशुद्धिस्तथाऽऽन्तरम् ॥' इति स्मृतेः ।",
 "13.8.s10": "**स्थैर्यं** भयादिना स्वधर्मादचलनम् ।",
 "13.8.s11": "**आत्मविनिग्रहः** विशेषेण मनसो नियमनम् ॥८॥",
 "13.9.s1": "**इन्द्रियार्थेषु वैराग्यं** शब्दादिषु रागाभावः ।",
 "13.9.s2": "**अनहङ्कारः** अविद्यमानात्मगुणाभिमानमोहाभावः ।",
 "13.9.s3": "जन्मादिषु दुःखदोषयोरनुदर्शनमिति वा, दुःखरूपस्य दोषस्यानुदर्शनमिति वा ।",
 "13.9.s4": "अनुक्षणमनुसन्धानमित्यर्थः ॥९॥",
 "13.10.s1": "पुत्रदारगृहादिषु **असक्तिः** स्नेहाभावः ।",
 "13.10.s2": "**अनभिष्वङ्गः** अतिपक्वस्नेहाभावः ।",
 "13.10.s3": "**इष्टानिष्टोपपत्तिषु** ।",
 "13.10.s4": "उपपत्तिः प्राप्तिः, तत्र **नित्यं समचित्तत्वं** हर्षविषादयोरभावः ॥१०॥",
 "13.11.s1": "**अनन्ययोगेन** रमाब्रह्मादिस्वातन्त्र्यासम्बन्धेन तदविषयिणीति यावत् ।",
 "13.11.s2": "अत एवा**व्यभिचारिणी** ।",
 "13.11.s3": "**मयि भक्तिः** ।",
 "13.11.s4": "**विविक्तदेशसेवित्वम्**, जनसम्मर्दहीनशुद्धस्थानस्थितिः ॥११॥",
 "13.12.s1": "**अध्यात्मज्ञाननित्यत्वम्** परमात्मानमधिकृत्य स्थिते ज्ञाने नियतत्वम् ।",
 "13.12.s2": "**तत्त्वज्ञानार्थदर्शनम्** ।",
 "13.12.s3": "अपरोक्षज्ञानार्थं शास्त्रपर्यालोचनम् ।",
 "13.12.s4": "**एतत्** 'अमानित्वम्' इत्यादिनोक्तं विंशतिधर्मजातम् ।",
 "13.12.s5": "**ज्ञानमिति** ज्ञायतेऽनेनेति करणव्युत्पत्त्या ज्ञानसाधनं प्रोक्तम् ।",
 "13.12.s6": "**अतोऽन्यथा यत्** अस्ति **तदज्ञानं** ज्ञानसाधनं नेत्यर्थः ।",
 "13.12.s7": "यद्वा - ज्ञानशब्दः भावव्युत्पत्त्या संवित्परश्च ।",
 "13.12.s8": "तत्त्वज्ञानार्थस्य तत्त्वज्ञानविषयस्य विष्णोर्दर्शनम्, अपरोक्षज्ञानमित्यर्थः ।",
 "13.12.s9": "एतद्भगवद्विषयापरोक्षज्ञानं ज्ञानमिति प्रोक्तम् ।",
 "13.12.s10": "**अतोऽन्यथा यत् तज्ज्ञानं** न भवतीति ।",
 "13.12.s11": "इह ज्ञानशब्दो ज्ञानतत्साधनोभयपरः ।",
 "13.12.s12": "तत्त्वज्ञानार्थदर्शनमित्ययमप्युक्तदिशा शास्त्रपर्यालोचनरूपज्ञानसाधनपरः, अपरोक्षज्ञानपरश्च ।",
 "13.12.s13": "ततश्चैतच्छब्देनोभयं परामृश्य ज्ञानशब्देन भावकरणोभयव्युत्पत्त्या ज्ञानसाधनत्वज्ञानत्वयोर्विधानं युक्तमिति ज्ञेयम् ॥१२॥"
}